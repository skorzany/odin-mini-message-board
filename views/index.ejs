<%- include('./partials/header.ejs') %>
<main>
  <ul>
    <% if (locals.messages) messages.forEach(message => { %>
      <li>
        <h3><%= message.username %></h3>
        <p><%= message.text %></p>
        <p><%= message.added %></p>
        <a href="/message/<%= message.id %>">Message details</a>
      </li>
      <hr/>
    <% }) %>
  </ul>
</main>
<%- include('./partials/footer.ejs') %>