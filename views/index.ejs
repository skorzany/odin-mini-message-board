<%- include('./partials/header.ejs') %>
<main>
  <ul>
    <% messages.forEach((message, index) => { %>
      <li>
        <h3><%= message.user %></h3>
        <p><%= message.text %></p>
        <p><%= message.added %></p>
        <a href="/message/<%= index %>">Message details</a>
      </li>
      <hr/>
    <% }) %>
  </ul>
</main>
<%- include('./partials/footer.ejs') %>